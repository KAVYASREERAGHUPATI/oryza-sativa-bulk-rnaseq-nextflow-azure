/*
============================================================
Custom Nextflow configuration for nf-core/rnaseq
Project: Oryza sativa bulk RNA-seq analysis
Platform: Microsoft Azure Ubuntu VM
============================================================
*/

params {

    // Maximum resources available to a single pipeline process
    max_cpus   = 16
    max_memory = '650.GB'
    max_time   = '240.h'
}


/*
============================================================
Process execution settings
============================================================
*/

process {

    // Run tasks directly on the Azure Linux virtual machine
    executor = 'local'

    // Retry a failed task up to two times
    errorStrategy = { task.exitStatus in [130, 143, 137, 104, 134] ? 'retry' : 'terminate' }

    maxRetries = 2

    // Prevent multiple large processes from using excessive resources
    maxForks = 8
}


/*
============================================================
Docker settings
============================================================
*/

docker {

    // Enable Docker containers
    enabled = true

    // Remove temporary Docker containers after completion
    remove = true

    // Run containers as the current Linux user
    runOptions = "-u $(id -u):$(id -g)"
}


/*
============================================================
Nextflow working directories and reports
============================================================
*/

workDir = '/data/RNAseq_Project/work'

timeline {
    enabled = true
    file = '/data/RNAseq_Project/results/pipeline_info/execution_timeline.html'
}

report {
    enabled = true
    file = '/data/RNAseq_Project/results/pipeline_info/execution_report.html'
}

trace {
    enabled = true
    file = '/data/RNAseq_Project/results/pipeline_info/execution_trace.txt'
}

dag {
    enabled = true
    file = '/data/RNAseq_Project/results/pipeline_info/pipeline_dag.html'
}


/*
============================================================
Nextflow execution settings
============================================================
*/

executor {

    // Check task completion regularly
    pollInterval = '5 sec'

    // Stop waiting for queued tasks after this duration
    queueStatInterval = '1 min'
}
